---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects.js';
---
<BaseLayout>
  <section class="hero">
    <p class="eyebrow">UX Designer · Northern Ireland · Available immediately</p>
    <h1>I make complex things feel <em>clearer.</em></h1>
    <p class="hero-copy">I’m Alan Kelly, a UX designer and AI builder focused on thoughtful digital experiences, useful systems, and design that helps people move forward.</p>
    <a class="button" href="#work">Explore selected work <span>↓</span></a>
  </section>

  <section id="work" class="work-section" aria-labelledby="work-heading">
    <div class="section-intro"><p class="eyebrow">Selected work</p><h2 id="work-heading">A few things I’ve worked on.</h2></div>
    <div class="project-grid">
      {projects.map((project) => (
        <a class={`project-card ${project.accent}`} href={`${import.meta.env.BASE_URL}/work/${project.slug}/`}>
          <div class="project-art"><span>{project.number}</span><i></i></div>
          <p class="eyebrow">{project.eyebrow}</p><h3>{project.title}</h3><p>{project.description}</p>
          <div class="tags">{project.tags.map((tag) => <span>{tag}</span>)}</div>
        </a>
      ))}
    </div>
  </section>

  <section id="about" class="about-section">
    <div><p class="eyebrow">A little about me</p><h2>Curious by default.<br /><em>Practical by design.</em></h2></div>
    <div class="about-copy"><p>I care about the space between a user’s need and a team’s ability to meet it. My work brings research, structure, and craft together to make products easier to understand and more useful in the real world.</p><p>I’m heavily into AI-first workflows and AI building: using tools such as Codex, Claude, and Copilot to move quickly from an idea to something tangible, while keeping user-centred judgement at the heart of the work.</p><a href={`${import.meta.env.BASE_URL}/Alan-Kelly-UX-Designer-CV.pdf`}>Download my CV <span>↗</span></a><a href="https://www.linkedin.com/in/alan-kelly-16280a1b/" target="_blank" rel="noreferrer">Connect on LinkedIn <span>↗</span></a></div>
  </section>

  <section id="contact" class="contact-section">
    <p class="eyebrow">Have a project in mind?</p><h2>Let’s make it<br /><em>make sense.</em></h2>
    <form action="https://formspree.io/f/your-form-id" method="POST">
      <label>Name<input name="name" type="text" autocomplete="name" required /></label>
      <label>Email<input name="email" type="email" autocomplete="email" required /></label>
      <label>Message<textarea name="message" rows="5" required></textarea></label>
      <button class="button" type="submit">Send message <span>↗</span></button>
    </form>
  </section>
</BaseLayout>
<style>
  .hero { min-height:72vh; display:flex; flex-direction:column; justify-content:center; max-width:900px; padding:7rem 0 8rem; }
  .eyebrow { color:var(--accent); font-size:.75rem; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }
  h1,h2,h3,p { margin-top:0; } h1,h2,h3 { line-height:1.08; letter-spacing:-.055em; } h1 { font-size:clamp(3.3rem,8vw,7rem); max-width:850px; margin:.5rem 0 1.5rem; } h2 { font-size:clamp(2.5rem,5vw,4.6rem); } h3 { font-size:1.7rem; margin:.35rem 0 .55rem; } em { color:var(--accent); font-style:normal; }
  .hero-copy { max-width:560px; color:var(--muted); font-size:1.05rem; margin-bottom:2rem; }.button { display:inline-flex; gap:1rem; align-items:center; align-self:flex-start; background:var(--text); color:var(--bg); border:0; border-radius:999px; padding:.8rem 1.1rem; font:600 .8rem 'Montserrat'; text-decoration:none; cursor:pointer; }.button span { color:var(--accent); font-size:1.1rem; }
  .work-section { padding:5rem 0; }.section-intro { display:flex; justify-content:space-between; align-items:end; gap:2rem; margin-bottom:2.5rem; }.section-intro h2 { max-width:550px; margin:0; }.project-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:1.2rem; }.project-card { display:block; color:var(--text); text-decoration:none; }.project-art { height:280px; border-radius:1.2rem; margin-bottom:1.3rem; padding:1.2rem; position:relative; overflow:hidden; }.project-art span { position:relative; z-index:1; font-weight:700; font-size:1.3rem; }.project-art i { position:absolute; width:240px; height:240px; border-radius:50%; right:-40px; bottom:-70px; background:rgba(255,255,255,.42); transition:transform .4s ease; }.project-card:hover .project-art i { transform:scale(1.18) translate(-12px,-10px); }.coral .project-art { background:#f2a18b; }.blue .project-art { background:#92b8d7; }.green .project-art { background:#96c5ae; }.project-card > p:not(.eyebrow) { color:var(--muted); font-size:.88rem; max-width:320px; }.tags { display:flex; flex-wrap:wrap; gap:.45rem; }.tags span { color:var(--muted); border:1px solid var(--line); border-radius:999px; padding:.25rem .55rem; font-size:.67rem; }
  .about-section,.contact-section { display:grid; grid-template-columns:1fr 1fr; gap:5rem; padding:9rem 0; border-top:1px solid var(--line); }.about-copy { max-width:520px; color:var(--muted); padding-top:2rem; }.about-copy a { display:block; margin-top:1.3rem; font-weight:600; text-decoration:none; }.about-copy a span { color:var(--accent); margin-left:.5rem; }.contact-section h2 { margin:0; }.contact-section form { display:grid; gap:1rem; }.contact-section label { color:var(--muted); font-size:.76rem; font-weight:600; }.contact-section input,.contact-section textarea { display:block; width:100%; margin-top:.4rem; border:1px solid var(--line); border-radius:.5rem; background:var(--surface); color:var(--text); padding:.75rem; font:inherit; resize:vertical; }.contact-section textarea { min-height:130px; }.contact-section .button { margin-top:.5rem; }
  @media(max-width:800px) { .project-grid { grid-template-columns:1fr; }.project-art { height:220px; }.about-section,.contact-section { grid-template-columns:1fr; gap:1rem; padding:6rem 0; }.about-copy { padding-top:0; }.section-intro { display:block; } }
</style>
